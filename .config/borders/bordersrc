#!/bin/bash

# JankyBorders — focused-window border, "floating card / 3D" feel.
# Active = a gradient in Raj's brand palette (turquoise → coral), the same
# accents used across the blog OG banners. Restrained, branded, premium.
options=(
	style=round
	width=5.0
	hidpi=off
	active_color="gradient(top_left=0xff3fc1c9,bottom_right=0xfff08a5d)"
	inactive_color=0x40555555
)

borders "${options[@]}"
